# Abody environment variables.
# Live site (Vercel): set these in Vercel → Project → Settings → Environment Variables.
# Local dev: copy this file to .env and use the "Local:" values in the comments.
# Never use the live database or live Stripe keys on your computer.

# --- Database (Neon PostgreSQL) -----------------------------------------------
# Live: the pooled Neon URL (host contains "-pooler").
# Local: a separate Neon "dev" branch or a local Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/abody?sslmode=require"

# --- Site ---------------------------------------------------------------------
# Local: http://localhost:3000
SITE_URL="https://abody.net"

# --- Stripe -------------------------------------------------------------------
# Live: sk_live_... from the Stripe dashboard. Local: sk_test_...
STRIPE_SECRET_KEY="sk_live_..."
# Live: from the webhook endpoint https://abody.net/api/stripe/webhook in Stripe.
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (Resend) -----------------------------------------------------------
# abody.net must be verified in Resend. Leave all three unset locally to turn
# email off.
RESEND_API_KEY="re_..."
EMAIL_FROM="Abody <orders@abody.net>"
ADMIN_NOTIFICATION_EMAIL="admin@abody.net"

# --- Rate limits --------------------------------------------------------------
# Live on Vercel: x-real-ip. Local: leave unset.
RATE_LIMIT_IP_HEADER="x-real-ip"

# --- Product files (Cloudflare R2) --------------------------------------------
# Live: required, Vercel cannot keep uploaded files on disk.
# Local: leave all unset to use the storage/ folder.
# The bucket needs a CORS rule allowing PUT from https://abody.net (see README).
S3_BUCKET="abody-files"
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# --- Tests only, never set on the live site -----------------------------------
# STRIPE_API_BASE="http://localhost:12111"
